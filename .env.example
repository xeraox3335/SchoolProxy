# ─── Server ──────────────────────────────────────────────────────────────────
# Port the proxy listens on (Heroku/Railway/Fly set this automatically)
PORT=3000

# ─── Logging ─────────────────────────────────────────────────────────────────
# Morgan format: combined | common | dev | short | tiny
LOG_FORMAT=combined

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Set to "false" to disable completely
RATE_LIMIT=true
# Max requests per IP per 60-second window
RATE_LIMIT_MAX=2000

# ─── Upstream request settings ───────────────────────────────────────────────
# Timeout (ms) for each outbound HTTP/HTTPS request
REQUEST_TIMEOUT_MS=30000
# Timeout (ms) for CONNECT tunnel sockets (system proxy)
TUNNEL_TIMEOUT_MS=60000
# Max size (bytes) of a buffered HTML/CSS response (50 MB default)
MAX_RESPONSE_SIZE=52428800

# ─── TLS ─────────────────────────────────────────────────────────────────────
# Set to "false" to allow self-signed certificates on target hosts
# (useful in school / corporate networks with inspection proxies)
REJECT_UNAUTHORIZED=true
